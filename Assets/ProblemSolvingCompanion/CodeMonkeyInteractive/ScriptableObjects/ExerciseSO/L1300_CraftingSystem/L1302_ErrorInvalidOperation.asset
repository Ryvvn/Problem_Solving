  exerciseName: ErrorInvalidOperation
  exerciseTitle: Error InvalidOperation
  videoWalkthroughUrl: https://unitycodemonkey.teachable.com/courses/problem-solving/lectures/63458716
  exerciseText: Crafting throws error
  hintText: You cannot modify a collection while cycling through it. Make a clone
    instead
  solutionText: "\r\n            List<ItemSO> cloneItemSOList = new List<ItemSO>(itemSOList);\r\n           
    foreach (ItemSO itemSO in testItemSOList) {\r\n                if (cloneItemSOList.Contains(itemSO))
    {\r\n                    cloneItemSOList.Remove(itemSO);\r\n                }
    else {\r\n                    // Does not contain\r\n                    return
    false;\r\n                }\r\n            }"
