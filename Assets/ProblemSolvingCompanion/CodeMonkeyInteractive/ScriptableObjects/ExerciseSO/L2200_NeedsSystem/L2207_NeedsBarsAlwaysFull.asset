  m_Script: {fileID: 11500000, guid: 1e0d8dd5b8f33e34b965fec3f1ff8d3e, type: 3}
  m_Name: L2207_NeedsBarsAlwaysFull
  m_EditorClassIdentifier: 
  exerciseNumber: 07
  exerciseName: NeedsBarsAlwaysFull
  exerciseTitle: Needs Bars always Full
  videoWalkthroughUrl: https://unitycodemonkey.teachable.com/courses/problem-solving/lectures/64202516
  exerciseText: Needs bars are always full.
  hintText: Why are the bars full but the numbers are going down? What is the difference
    in those two?
  solutionText: The NeedsSystem is doing some wrong normalized math, it should be
    dividing the current amount by the maximum, not the other way around.
